  audiobookshelf:
    image: "{{ service_config.image }}"
    container_name: audiobookshelf
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ="{{ timezone }}"
      - ROUTER_BASE_PATH=/audiobookshelf
    volumes:
      - "{{ data_root }}/media/audiobooks:/data/media/audiobooks"
      - "{{ config_root }}/audiobookshelf/config:/config"
      - "{{ config_root }}/audiobookshelf/metadata:/metadata"
{% set use_vpn = service_config.use_vpn | default(false) %}
{% set host_port = service_config.port %}
{% set internal_port = item.internal_port | default(80) %}
{% include "_service_network.yml.j2" %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:80/"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
