  discord-bridge:
    image: "{{ service_config.image }}"
    container_name: discord-bridge
    command: ["sh", "-c", "pip install --no-cache-dir discord.py aiohttp && python -u /app/discord_bridge.py"]
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ="{{ timezone }}"
      - DISCORD_BOT_TOKEN={{ discord_secret.bot_token }}
      - 'USERS_JSON={{ overseerr_secret.users | to_json }}'
    volumes:
      - "{{ config_root }}/discord-bridge:/app"
{% set use_vpn = service_config.use_vpn | default(false) %}
{% set host_port = service_config.port %}
{% set internal_port = 9000 %}
{% include "_service_network.yml.j2" %}
    restart: unless-stopped
