  cleanuparr-init:
    image: "keinos/sqlite3:latest"
    container_name: cleanuparr-init
    user: "root"
    volumes:
      - "{{ config_root }}/cleanuparr:/config"
    command: >
      sh -c "
      set -e;
      sqlite3 /config/users.db < /config/inject_users.sql;
      sqlite3 /config/cleanuparr.db < /config/inject_configs.sql;
      chown {{ puid }}:{{ pgid }} /config/*.db
      "

{% from "service_base.yml.j2" import standard_service with context %}
{{ standard_service(
    name="cleanuparr",
    internal_port=11011,
    env=['PORT=11011'],
    depends_on={'cleanuparr-init': 'service_completed_successfully'},
    healthcheck_cmd=["CMD-SHELL", "curl -f http://127.0.0.1:11011/api/health || curl -f http://127.0.0.1:11011/ || exit 1"]
) }}
