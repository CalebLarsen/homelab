  cleanuparr:
    image: "{{ service_config.image }}"
    container_name: cleanuparr
    restart: unless-stopped
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ={{ timezone }}
      - PORT=11011
    volumes:
      - "{{ config_root }}/cleanuparr:/config"
{% set use_vpn = service_config.use_vpn | default(false) %}
{% set host_port = service_config.port %}
{% set internal_port = 11011 %}
{% include "_service_network.yml.j2" %}
