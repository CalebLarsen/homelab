  ci-mock:
    image: "nginx:alpine"
    container_name: ci-mock
    volumes:
      - "{{ homelab_project_root }}/ci-mock:/usr/share/nginx/html:ro"
      - "{{ homelab_project_root }}/ci-mock/nginx.conf:/etc/nginx/nginx.conf:ro"
    networks:
      - "{{ docker_network }}"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:80/"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
