  seerr:
    image: "{{ service_config.image }}"
    container_name: seerr
    init: true  # Required by Seerr (ghcr.io/seerr-team/seerr); see decisions/0007.
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ="{{ timezone }}"
    volumes:
      # Seerr's config path is /app/config (Overseerr/LSIO used /config).
      # Mounting the same host appdata triggers Seerr's automatic in-place
      # migration on first start — see decisions/0007 and
      # https://docs.seerr.dev/migration-guide.
      - "{{ config_root }}/seerr:/app/config"
{% set use_vpn = service_config.use_vpn | default(false) %}
{% set host_port = service_config.port %}
{% set internal_port = 5055 %}
{% include "_service_network.yml.j2" %}
    restart: unless-stopped
    depends_on:
      plex:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:5055/"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
