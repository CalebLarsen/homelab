  flaresolverr:
    image: "{{ service_config.image }}"
    container_name: flaresolverr
{% set use_vpn = service_config.use_vpn | default(false) %}
{% set host_port = service_config.port %}
{% set internal_port = 8191 %}
{% include "_service_network.yml.j2" %}
    environment:
      - LOG_LEVEL=info
      - LOG_HTML=false
      - CAPTCHA_SOLVER=none
      - TZ="{{ timezone }}"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8191/"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
