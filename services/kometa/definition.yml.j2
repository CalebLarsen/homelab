  kometa:
    image: "{{ service_config.image }}"
    container_name: kometa
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ="{{ timezone }}"
    volumes:
      - "{{ config_root }}/kometa:/config"
    networks:
      - "{{ docker_network }}"
    restart: unless-stopped
    depends_on:
      plex:
        condition: service_healthy
