  anki:
    image: "{{ service_config.image }}"
    container_name: anki
    environment:
      - PUID={{ puid }}
      - PGID={{ pgid }}
      - TZ="{{ timezone }}"
      - SYNC_USER1={{ anki_secret.sync_user1 }}
      - SYNC_USER2={{ anki_secret.sync_user2 }}
    volumes:
      - "{{ config_root }}/anki:/anki_data"
{% set use_vpn = service_config.use_vpn | default(false) %}
{% set host_port = service_config.port %}
{% set internal_port = item.internal_port | default(8080) %}
{% include "_service_network.yml.j2" %}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
