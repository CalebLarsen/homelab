{% from "service_base.yml.j2" import standard_service with context %}
{{ standard_service(
    name="audiobookbay-automated",
    internal_port=service_config.port,
    env=[
        'DOWNLOAD_CLIENT=qbittorrent',
        'DL_SCHEME=http',
        'DL_HOST=gluetun',
        'DL_PORT=6969',
        'DL_USERNAME=admin',
        'DL_PASSWORD=' ~ admin_password,
        'DL_CATEGORY=audiobooks',
        'SAVE_PATH_BASE=/data/media/audiobooks',
        'ABB_HOSTNAME=audiobookbay.lu',
        'FLASK_PORT=' ~ service_config.port
    ],
    depends_on={'qbittorrent': 'service_healthy'},
    healthcheck_cmd=["CMD", "python3", "-c", "import socket; s = socket.socket(); s.settimeout(5); s.connect(('127.0.0.1', " ~ service_config.port ~ "))"]
) }}
