{% from "service_base.yml.j2" import standard_service with context %}
{{ standard_service(
    name="phone-logger",
    internal_port=service_config.port,
    env=[
        'PYTHONUNBUFFERED=1',
        'PHONE_LOGGER_DATA_DIR=/app/data'
    ],
    volumes=[config_root ~ "/phone-logger/data:/app/data"],
    healthcheck_cmd=["CMD", "python3", "-c", "import socket; s = socket.socket(); s.settimeout(5); s.connect(('127.0.0.1', " ~ service_config.port ~ "))"]
) }}
